NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Instancias de producción consultadas en Usuarios (solo sk_live_...).
# Detección automática en Vercel; las claves Secret/Sensitive se conectan aquí.
# Otros proyectos: NOMBRE_DEL_PROYECTO_CLERK_SECRET_KEY (guiones -> guiones bajos).
DIARIAMENTE_CLERK_SECRET_KEY=
REPLAY_CLERK_SECRET_KEY=
INVOICER_CLERK_SECRET_KEY=
TAREAS_CLERK_SECRET_KEY=
# API de administración de Diariamente (planes y acceso de por vida).
DIARIAMENTE_API_URL=https://diariamente.es
DIARIAMENTE_ADMIN_API_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
ADMIN_USER_IDS=
ADMIN_EMAILS=
VERCEL_TOKEN=
VERCEL_TEAM_ID=
APP_URL=http://localhost:3018
# Transcriptor de TikTok: clave gratuita de https://console.groq.com/keys
GROQ_API_KEY=
# YouTube en Vercel: plan gratuito de https://dash.supadata.ai (sin tarjeta).
# Solo subtítulos existentes; no genera ni traduce con IA.
SUPADATA_API_KEY=
# Opcionales: histórico de Log Drains
DATABASE_URL=
VERCEL_DRAIN_SECRET=
VERCEL_DRAIN_VERIFY=
# Opcionales: Sentry y Supabase como fuentes de logs
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_URL=https://de.sentry.io
SENTRY_PROJECTS=
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECTS=
# Actividad diaria de GitHub (repositorios privados incluidos según permisos).
GITHUB_USERNAME=
GITHUB_ACTIVITY_TOKEN=
# Resumen del día con IA gratuita (Groq, sin tarjeta): https://console.groq.com/keys
GROQ_API_KEY=
# Opcional: modelo de Groq (por defecto openai/gpt-oss-120b)
ACTIVITY_AI_MODEL=
# Secreto aleatorio compartido con URITHIRU_CRON_SECRET en GitHub Actions.
CRON_SECRET=
